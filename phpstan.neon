includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
    ignoreErrors:
        # No model uses it until the first tenant-scoped table exists. This
        # entry then stops matching and PHPStan asks for its removal.
        - identifier: trait.unused
          path: app/Tenancy/BelongsToTenant.php
