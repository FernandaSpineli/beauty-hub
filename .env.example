# Copy to .env and adjust. Never commit .env.

APP_NAME="Beauty Hub"
APP_ENV=local
# Generate with: docker compose run --rm dev php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=debug

# Matches the local-only credentials in docker-compose.yml. Hosts and ports are
# overridden inside compose; these values work from the host.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=beauty
DB_USERNAME=beauty
DB_PASSWORD=beauty

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@beautyhub.localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Host ports published by docker compose. If one is taken, change it here and
# in the matching DB_PORT / REDIS_PORT above (used when running on the host).
FORWARD_APP_PORT=8000
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_UI_PORT=8025
